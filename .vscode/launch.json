// A launch configuration that launches the extension inside a new window
// Use IntelliSense to learn about possible attributes.
// Hover to view descriptions of existing attributes.
// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Client (Development)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/vscode-extension"],
      "outFiles": ["${workspaceFolder}/vscode-extension/client/out/**/*.js"],
      "preLaunchTask": "Watch Client",
      "env": {
        "SERVER_PATH": "${workspaceFolder}/slice-lsp/target/",
        "BUILT_IN_SLICE_PATH": "${workspaceFolder}/vscode-extension/slice/"
      }
    }
  ]
}
